# Salin file ini jadi .env lalu sesuaikan nilainya

APP_NAME=AI Accounting RAG
DEBUG=True
ENV=development

# Database — default SQLite (tanpa server). Override penuh kalau mau DB lain:
# DATABASE_URL_OVERRIDE=postgresql+psycopg2://user:pass@host:5432/db

# Qdrant — isi QDRANT_HOST + QDRANT_API_KEY untuk cloud, atau kosongkan
# QDRANT_API_KEY untuk mode embedded lokal (tanpa server/Docker).
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=accounting_knowledge_v2

# Ollama — cloud (ollama.com): isi OLLAMA_API_KEY (key milik kalian, di-bundle
# ke desktop app). Lokal: kosongkan key + OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Embedding RAG
#   fastembed (default) — lokal, gratis, tanpa API key
#   openai              — OpenAI-compatible /v1/embeddings (butuh EMBEDDING_API_KEY)
#   ollama              — pakai Ollama lokal
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_DIMENSIONS=1536

# Auth
SECRET_KEY=ganti-dengan-random-string-yang-panjang-dan-rahasia
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (pisahkan dengan koma kalau lebih dari satu, format JSON list didukung pydantic-settings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
